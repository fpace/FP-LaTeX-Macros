\ExplSyntaxOff

\IfFormatAtLeastTF{2022-06-01}
   {%
     \ExplSyntaxOn
     \ProcessKeyOptions [ fp-macros ]
     \ExplSyntaxOff
   }
   {%
     \RequirePackage{l3keys2e}

     \ExplSyntaxOn
     \ProcessKeyOptions { fp-macros }
     \ExplSyntaxOff
   }


