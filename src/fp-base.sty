\NeedsTexFormat[LaTeX2e][2020-02-02]

% ======================================================================================
% Minimum LaTeX version
% ======================================================================================

% \IfFormatAtLEastTF is available in modern LaTeX kernels.
% This fallback keeps the check compatible with older supported formats.
\providecommand\ifFormatAtLeastTF{\@ifl@t@r\fmtversion}

\IfFormatAtLEastTF{2020-02-02}
   {}
   {%
     \PackageError{fp-base}{LaTeX kernel too old}
        {%
          fp-macros requires LaTeX 2020-02-02 or newer.\MessageBreak
          Please update your TeX distribution.\MessageBreak
          Loading fp-macros will abort!%
        }%
        \endinput
   }

\providecommand\IfExplAtLeastTF{\@ifl@t@r\ExplLoaderFileDate}
\IfExplAtLeastTF\ExplLoaderFileDate{2018-05-05}
   {}
   {%
     \PackageError{fp-base}{Support package expl3 too old}
        {%
          fp-macros requires package expl3 2018-05-05 or newer.\MessageBreak
          Please update your TeX distribution.\MessageBreak
          Loadiing fp-macros will abort!%
        }%
        \endinput
   }

